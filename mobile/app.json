{
  "expo": {
    "name": "Family OS",
    "slug": "familyos",
    "version": "0.1.1",
    "orientation": "portrait",
    "scheme": "familyos",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.familyos.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Unlock Family OS with Face ID after you sign in.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "package": "com.familyos.app",
      "versionCode": 2,
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "familyos",
              "host": "invite",
              "pathPrefix": "/"
            },
            {
              "scheme": "familyos",
              "pathPrefix": "/invite"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Family OS to use Face ID / fingerprint to unlock your session."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0F172A",
          "sounds": []
        }
      ],
      "expo-splash-screen",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0F172A"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "e6998ca4-3dc2-4ca1-9c0c-eb1e100276e2"
      }
    },
    "owner": "tmassey1979",
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}