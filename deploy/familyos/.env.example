# Copy to .env and fill in before deploy:
#   cp deploy/familyos/.env.example deploy/familyos/.env

DOMAIN=yourdomain.com
ACME_EMAIL=you@yourdomain.com

POSTGRES_USER=familyos
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES
POSTGRES_DB=familyos

RABBITMQ_USER=familyos
RABBITMQ_PASSWORD=CHANGE_ME_RABBIT

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_KEYCLOAK

VERSION=0.1.0
SEED_ENABLED=true
TZ=America/Chicago

AUTH_USE_DEV_BYPASS=false

# Observability
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
