{
  "realm": "familyos",
  "enabled": true,
  "displayName": "Family OS",
  "sslRequired": "external",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "loginTheme": "keycloak.v2",
  "accountTheme": "keycloak.v2",
  "emailTheme": "keycloak",
  "defaultSignatureAlgorithm": "RS256",
  "clients": [
    {
      "clientId": "familyos-mobile",
      "name": "Family OS Mobile",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "protocol": "openid-connect",
      "redirectUris": [
        "familyos://*",
        "familyos://auth",
        "familyos://auth/*",
        "exp://*",
        "http://localhost:*",
        "http://127.0.0.1:*",
        "https://*.sslip.io/*",
        "https://18.226.226.118.sslip.io/*",
        "https://auth.expo.io/*",
        "https://*.expo.dev/*",
        "https://*.exp.direct/*"
      ],
      "webOrigins": [
        "*"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    },
    {
      "clientId": "familyos-api",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "protocol": "openid-connect",
      "bearerOnly": true
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Standard Family OS user"
      }
    ]
  }
}
